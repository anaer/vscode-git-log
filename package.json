{
  "name": "git-log-0",
  "displayName": "0: Git Log — Commit Graph & History",
  "description": "A visual Git log, commit graph, history browser, and repository operations extension for Visual Studio Code.",
  "version": "26.1109.946",
  "publisher": "anaer",
  "license": "MIT",
  "icon": "media/git-log.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/anaer/vscode-git-log.git"
  },
  "homepage": "https://github.com/anaer/vscode-git-log#readme",
  "bugs": {
    "url": "https://github.com/anaer/vscode-git-log/issues"
  },
  "private": true,
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "SCM Providers",
    "Visualization"
  ],
  "keywords": [
    "git",
    "git log",
    "commit graph",
    "history"
  ],
  "main": "./dist/extension.js",
  "l10n": "./l10n",
  "activationEvents": [
    "onStartupFinished",
    "onCommand:gitLogWorkbench.openLog",
    "onCommand:gitLogWorkbench.editor.showLineHistory",
    "onCommand:gitLogWorkbench.editor.showSelectionHistory",
    "onCommand:gitLogWorkbench.editor.showFileHistory",
    "onCommand:gitLogWorkbench.explorer.showFolderHistory",
    "onCommand:gitLogWorkbench.editor.compareFileWithRef",
    "onCommand:gitLogWorkbench.applyPatch",
    "onCommand:gitLogWorkbench.showDiagnostics",
    "onCommand:gitLogWorkbench.showGitConsole",
    "onCommand:gitLogWorkbench.config.multiRepo",
    "onCommand:gitLogWorkbench.pull.ffOnly",
    "onCommand:gitLogWorkbench.pull.merge",
    "onCommand:gitLogWorkbench.pull.rebase",
    "onView:gitLogWorkbench.log"
  ],
  "contributes": {
    "commands": [
      {
        "command": "gitLogWorkbench.openLog",
        "title": "%command.openLog.title%",
        "category": "Git Log",
        "icon": "$(git-branch)"
      },
      {
        "command": "gitLogWorkbench.editor.showLineHistory",
        "title": "%command.showLineHistory.title%",
        "category": "Git Log"
      },
      {
        "command": "gitLogWorkbench.editor.showSelectionHistory",
        "title": "%command.showSelectionHistory.title%",
        "category": "Git Log"
      },
      {
        "command": "gitLogWorkbench.editor.showFileHistory",
        "title": "%command.showFileHistory.title%",
        "category": "Git Log"
      },
      {
        "command": "gitLogWorkbench.explorer.showFolderHistory",
        "title": "%command.showFolderHistory.title%",
        "category": "Git Log"
      },
      {
        "command": "gitLogWorkbench.editor.compareFileWithRef",
        "title": "%command.compareFileWithRef.title%",
        "category": "Git Log"
      },
      {
        "command": "gitLogWorkbench.applyPatch",
        "title": "%command.applyPatch.title%",
        "category": "Git Log"
      },
      {
        "command": "gitLogWorkbench.showDiagnostics",
        "title": "%command.showDiagnostics.title%",
        "category": "Git Log"
      },
      {
        "command": "gitLogWorkbench.showGitConsole",
        "title": "%command.showGitConsole.title%",
        "category": "Git Log"
      },
      {
        "command": "gitLogWorkbench.config.multiRepo",
        "title": "%command.configMultiRepo.title%",
        "category": "Git Log"
      },
      {
        "command": "gitLogWorkbench.pull.ffOnly",
        "title": "%command.pullFfOnly.title%",
        "category": "Git Log"
      },
      {
        "command": "gitLogWorkbench.pull.merge",
        "title": "%command.pullMerge.title%",
        "category": "Git Log"
      },
      {
        "command": "gitLogWorkbench.pull.rebase",
        "title": "%command.pullRebase.title%",
        "category": "Git Log"
      }
    ],
    "submenus": [
      {
        "id": "gitLogWorkbench.editorContext",
        "label": "%submenu.gitLog.label%"
      },
      {
        "id": "gitLogWorkbench.explorerContext",
        "label": "%submenu.gitLog.label%"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "submenu": "gitLogWorkbench.editorContext",
          "when": "resourceScheme == file",
          "group": "navigation@20"
        }
      ],
      "explorer/context": [
        {
          "submenu": "gitLogWorkbench.explorerContext",
          "when": "resourceScheme == file",
          "group": "navigation@20"
        }
      ],
      "gitLogWorkbench.explorerContext": [
        {
          "command": "gitLogWorkbench.editor.showFileHistory",
          "when": "resourceScheme == file && !explorerResourceIsFolder",
          "group": "1_history@1"
        },
        {
          "command": "gitLogWorkbench.explorer.showFolderHistory",
          "when": "resourceScheme == file && explorerResourceIsFolder",
          "group": "1_history@1"
        }
      ],
      "commandPalette": [
        {
          "command": "gitLogWorkbench.explorer.showFolderHistory",
          "when": "false"
        }
      ],
      "gitLogWorkbench.editorContext": [
        {
          "command": "gitLogWorkbench.editor.showLineHistory",
          "when": "resourceScheme == file && !editorHasSelection",
          "group": "1_history@1"
        },
        {
          "command": "gitLogWorkbench.editor.showSelectionHistory",
          "when": "resourceScheme == file && editorHasSelection",
          "group": "1_history@1"
        },
        {
          "command": "gitLogWorkbench.editor.showFileHistory",
          "when": "resourceScheme == file",
          "group": "1_history@2"
        },
        {
          "command": "gitLogWorkbench.editor.compareFileWithRef",
          "when": "resourceScheme == file",
          "group": "2_compare@1"
        }
      ]
    },
    "viewsContainers": {
      "panel": [
        {
          "id": "gitLogWorkbench",
          "title": "Git Log",
          "icon": "$(git-branch)"
        }
      ]
    },
    "views": {
      "gitLogWorkbench": [
        {
          "id": "gitLogWorkbench.log",
          "name": "Git Log",
          "type": "webview"
        }
      ]
    },
    "configuration": {
      "title": "%configuration.title%",
      "properties": {
        "gitLogWorkbench.git.path": {
          "type": "string",
          "default": "git",
          "description": "%config.gitPath.description%"
        },
        "gitLogWorkbench.pull.strategy": {
          "type": "string",
          "enum": [
            "default",
            "ff-only",
            "merge",
            "rebase"
          ],
          "enumDescriptions": [
            "%config.pullStrategy.enumDefault.description%",
            "%config.pullStrategy.enumFfOnly.description%",
            "%config.pullStrategy.enumMerge.description%",
            "%config.pullStrategy.enumRebase.description%"
          ],
          "default": "default",
          "description": "%config.pullStrategy.description%"
        },
        "gitLogWorkbench.currentLineBlame.enabled": {
          "type": "boolean",
          "default": true,
          "description": "%config.currentLineBlameEnabled.description%"
        },
        "gitLogWorkbench.lineHistory.contextLines": {
          "type": "number",
          "default": 3,
          "minimum": 0,
          "maximum": 20,
          "description": "%config.lineHistoryContextLines.description%"
        },
        "gitLogWorkbench.repositories.scanDepth": {
          "type": "number",
          "default": 2,
          "minimum": 0,
          "maximum": 8,
          "description": "%config.repositoriesScanDepth.description%"
        },
        "gitLogWorkbench.repositories.exclude": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            "**/node_modules/**",
            "**/.worktrees/**"
          ],
          "description": "%config.repositoriesExclude.description%"
        },
        "gitLogWorkbench.log.initialPageSize": {
          "type": "number",
          "default": 200,
          "minimum": 20,
          "maximum": 2000
        },
        "gitLogWorkbench.log.pageSize": {
          "type": "number",
          "default": 500,
          "minimum": 20,
          "maximum": 5000
        },
        "gitLogWorkbench.performance.maxCachedCommits": {
          "type": "number",
          "default": 5000,
          "minimum": 200,
          "maximum": 50000
        },
        "gitLogWorkbench.performance.maxDiffFileBytes": {
          "type": "number",
          "default": 5242880,
          "minimum": 1024,
          "maximum": 104857600,
          "description": "%config.maxDiffFileBytes.description%"
        },
        "gitLogWorkbench.debug.logLevel": {
          "type": "string",
          "enum": [
            "off",
            "error",
            "debug"
          ],
          "default": "debug"
        },
        "gitLogWorkbench.debug.consoleEntries": {
          "type": "number",
          "default": 500,
          "minimum": 0,
          "maximum": 5000,
          "description": "%config.debugConsoleEntries.description%"
        },
        "gitLogWorkbench.debug.consoleVerbose": {
          "type": "boolean",
          "default": false,
          "description": "%config.debugConsoleVerbose.description%"
        },
        "gitLogWorkbench.history.protectedBranches": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            "main",
            "master"
          ],
          "description": "%config.protectedBranches.description%"
        }
      }
    }
  },
  "scripts": {
    "clean": "node scripts/clean.mjs",
    "build": "node scripts/build.mjs",
    "watch": "node scripts/build.mjs --watch",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:unit": "vitest run test/unit",
    "test:integration": "npm run build && node ./scripts/run-integration.mjs",
    "test:performance": "vitest run test/performance",
    "package": "npm run clean && npm run build && vsce package --no-dependencies --allow-missing-repository --no-rewrite-relative-links"
  },
  "dependencies": {
    "flatpickr": "^4.6.13",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "shiki": "^3.23.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^22.18.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/vscode": "1.85.0",
    "@vscode/test-electron": "^3.1.0",
    "@vscode/vsce": "^3.9.2",
    "esbuild": "^0.28.2",
    "eslint": "^10.0.0",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "jsdom": "^27.0.0",
    "prettier": "^3.6.2",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.67.0",
    "vitest": "^4.1.10"
  }
}
